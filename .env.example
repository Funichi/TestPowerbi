# Copia questo file in .env.local e inserisci i valori veri (mai committare .env.local)

# Supabase - trovi questi valori in: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps - trovi/crei questa chiave in Google Cloud Console > Credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
